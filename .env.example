# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (client) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# --- ImageKit (client) ---
# Both values are public and safe to ship in the browser bundle.
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
VITE_IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- ImageKit (server) ---
# The private key must NEVER be given a VITE_ prefix or placed in this file's
# committed form. Anything prefixed VITE_ is inlined into the browser bundle.
#
# For the running app, set it on the edge function:
#   supabase secrets set IMAGEKIT_PRIVATE_KEY=private_xxxx IMAGEKIT_PUBLIC_KEY=public_xxxx
#
# The catalog image scripts (scripts/uploadImagesToImageKit.mjs) read it from
# .env.local or the environment instead, since they run outside the function:
# IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
