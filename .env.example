# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (client) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# --- Cloudflare R2 (client) ---
# Public and safe for the browser bundle.
VITE_R2_PUBLIC_URL=https://images.row-nel.com
VITE_CLOUDFLARE_IMAGE_TRANSFORMATIONS=true

# --- Cloudflare R2 (server) ---
# Server and migration scripts only; configure these in Vercel/local secrets.
# Never add VITE_ or EXPO_PUBLIC_ prefixes.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BUCKET=rownel-public-images
# R2_PRIVATE_BUCKET=rownel-private-images
# R2_PUBLIC_URL=https://images.row-nel.com

# Legacy ImageKit runtime settings remain required during the compatibility
# window; keep existing deployed values until R2 migration is validated.

# --- Apple MapKit JS ---
# The map and address search need a Maps token. There are two ways to get one;
# pick ONE.
#
# OPTION A — dashboard token (simplest, no server, no private key)
#   1. developer.apple.com/account -> Services -> Maps -> Configure
#   2. Tokens tab -> + -> Token Type: MapKit JS
#   3. Restriction Type: Domain, Websites: row-nel.com,localhost
#      (Domain restriction is what stops a copied token spending your quota.)
#   4. Create, copy the token, paste below.
# This is a VITE_ variable, so it ships in the browser bundle by design — the
# domain restriction is what protects it.
VITE_MAPKIT_TOKEN=your_dashboard_token

# OPTION B — signed tokens (private key stays on the server, 30-minute tokens)
# Leave VITE_MAPKIT_TOKEN empty and the app calls /api/mapkit-token instead.
# These are SERVER variables: no VITE_ prefix, because Vite inlines VITE_* into
# the browser bundle and the private key must never ship.
#
#   1. developer.apple.com/account/resources/identifiers -> new Maps ID
#   2. developer.apple.com/account/resources/authkeys    -> new key, tick
#      "MapKit JS", select that Maps ID, download the .p8 (one chance only)
#
# MAPKIT_TEAM_ID      10-character Team ID: developer.apple.com/account ->
#                     Membership, under the team name
# MAPKIT_KEY_ID       10-character key ID, shown on the key you created
# MAPKIT_PRIVATE_KEY  the whole .p8 file, BEGIN/END lines included. Escaped \n
#                     sequences are fine, which is how Vercel stores it.
# MAPKIT_ORIGIN       comma-separated domains, no scheme. REQUIRED: Apple
#                     refuses a mapkit_js token with no origin claim. Include
#                     localhost so `npm run dev:api` works; in the Vercel
#                     environment set the real domains only.
#
# Verify before trusting them:  npm run check:mapkit
MAPKIT_TEAM_ID=
MAPKIT_KEY_ID=
MAPKIT_PRIVATE_KEY=
MAPKIT_ORIGIN=row-nel.com,*.row-nel.com,localhost
