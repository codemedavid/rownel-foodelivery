{
  "expo": {
    "name": "Rownel Food Delivery",
    "slug": "rownel-foodelivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.rownel.foodelivery",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rownel.foodelivery",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#212C32",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rownel uses your location to show restaurants that deliver near you."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#dc2626",
          "defaultChannel": "orders",
          "sounds": [
            "./assets/sounds/new_order.wav"
          ]
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "scheme": "rownelfood",
    "extra": {
      "eas": {
        "projectId": "b2331856-6879-448c-8c5f-57dfc57c8b12"
      },
      "router": {}
    },
    "owner": "itscodemedavid"
  }
}
