EXPO_PUBLIC_SUPABASE_URL=your-supabase-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# The mobile app still geocodes through Mapbox; the web app has moved to Apple
# MapKit JS, which is browser-only. The Mapbox account was over its monthly
# quota at the time of that migration, so address search here fails
# intermittently until the quota resets or this app migrates to Apple's Maps
# Server API. See docs/testing/mapkit-migration.tdd.md.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_public_token_here
