EXPO_PUBLIC_SUPABASE_URL=your-supabase-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Maps ---
# The Rownel web deployment. This app has no Apple credentials of its own:
#
#   * Maps are MapKit JS, drawn in a WebView loading <origin>/map-embed.html.
#     A MapKit JS token is pinned to a domain, so the page has to be served
#     from that domain — a local HTML string would have no origin Apple
#     accepts.
#   * Address search and reverse geocoding go to <origin>/api/maps-search and
#     <origin>/api/maps-reverse, which call Apple's Maps Server API. The Apple
#     token stays on the server: a `server_api` token takes no origin claim, so
#     one shipped inside an installed app could spend the quota from anywhere.
#
# Set the web app's MAPKIT_TEAM_ID / MAPKIT_KEY_ID / MAPKIT_PRIVATE_KEY (see
# its .env.example) and maps work here with no further configuration.
#
# Use the canonical host: row-nel.com answers 307 and redirects to www, and
# there is no reason to pay for that on every map load.
#
# Use a LAN address, not localhost, when pointing at a dev server: localhost on
# a phone is the phone.
EXPO_PUBLIC_WEB_ORIGIN=https://www.row-nel.com
